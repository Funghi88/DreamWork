{
  "name": "dreamwork",
  "private": true,
  "repository": "github.com/annabellelee/dreamwork",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --port 5173",
    "build": "node scripts/update-updater-config.js && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "signaling": "npx tsx server/signaling-server.ts",
    "setup-updater": "node scripts/setup-updater.js",
    "create-app-icon": "node scripts/create-app-icon.js && npm run tauri icon -- src-tauri/app-icon.png",
    "create-app-icon:circle": "node scripts/create-app-icon.js --circle && npm run tauri icon -- src-tauri/app-icon.png"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
